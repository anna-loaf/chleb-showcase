# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIGDY nie trafia do repo (.gitignore).
# Na Vercelu te same zmienne wpisujesz w: Project → Settings → Environment Variables.

# ── Etap 1: czat z Chlebem ───────────────────────────────────────────────
# Klucz z https://platform.claude.com → Settings → API keys.
# Najlepiej: osobny workspace „chleb” z limitem wydatków i klucz utworzony w nim.
ANTHROPIC_API_KEY=

# Hasło dostępu do Twojego /api/chat (długie i losowe, np. 32 znaki).
# To samo wpiszesz raz w apce: Zaplecze → Hasło dostępu.
# Lokalnie (npm run dev) może zostać puste, na Vercelu jest wymagane.
CHLEB_ACCESS_TOKEN=

# ── Etap 2: skan skrzynki castingowej (dedykowany Gmail, NIE prywatny) ──
# Lokalnie: npm run scan -- --dry-run (tylko pokazuje trafienia, nic nie wysyła i nie oznacza).
# W GitHubie te same nazwy wpisujesz w Settings → Secrets and variables → Actions.
CASTING_IMAP_USER=
CASTING_IMAP_APP_PASSWORD=
# Klucze z: npm run vapid. Publiczny także na Vercelu jako VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj-adres-castingowy@gmail.com
VITE_VAPID_PUBLIC_KEY=
